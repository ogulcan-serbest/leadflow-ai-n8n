    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nconst text = (value) => typeof value === 'string' ? value.trim() : '';\nconst lead = {\n  name: text(raw.name),\n  email: text(raw.email).toLowerCase(),\n  company: text(raw.company),\n  message: text(raw.message),\n  source: text(raw.source) || 'unknown'\n};\nconst errors = [];\nif (!lead.name) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) errors.push('a valid email is required');\nif (lead.message.length < 10) errors.push('message must contain at least 10 characters');\nif (lead.message.length > 5000) errors.push('message must be 5000 characters or fewer');\nreturn [{ json: { ...lead, isValid: errors.length === 0, validationErrors: errors } }];"
      },
