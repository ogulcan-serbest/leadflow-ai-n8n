        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'gpt-4.1-mini', response_format: { type: 'json_object' }, messages: [{ role: 'system', content: 'Qualify this inbound business lead. Return only a JSON object with keys: summary (string), category (one of support, sales, partnership, other), priority (low, normal, high), fitReason (string), replyDraft (string). Do not invent facts or promise capabilities. The reply is only a draft for a human to review; do not claim anything has been sent.' }, { role: 'user', content: JSON.stringify({ name: $('Validate and normalize').first().json.name, company: $('Validate and normalize').first().json.company, message: $('Validate and normalize').first().json.message, source: $('Validate and normalize').first().json.source }) }] } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2fb69623-0c59-4e9b-ab45-496f465a1a33",
      "name": "Qualify lead and draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        112,
        -208
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Validate and normalize').first().json;\nconst raw = $input.first().json;\nconst content = raw.choices?.[0]?.message?.content;\nif (typeof content !== 'string') throw new Error('Model response did not contain message content');\nlet qualification;\ntry { qualification = JSON.parse(content); } catch { throw new Error('Model response was not valid JSON'); }\nconst allowedCategories = new Set(['support', 'sales', 'partnership', 'other']);\nconst allowedPriorities = new Set(['low', 'normal', 'high']);\nif (!allowedCategories.has(qualification.category)) qualification.category = 'other';\nif (!allowedPriorities.has(qualification.priority)) qualification.priority = 'normal';\nfor (const key of ['summary', 'fitReason', 'replyDraft']) {\n  if (typeof qualification[key] !== 'string') qualification[key] = '';\n}\nreturn [{ json: { lead: { name: lead.name, email: lead.email, company: lead.company, source: lead.source }, qualification, reviewRequired: true, autoSend: false } }];"
      },
